# Supabase (clé service : serveur uniquement, ne jamais exposer côté client)
SUPABASE_URL=
SUPABASE_SERVICE_ROLE_KEY=
# Zoho Mail (SMTP) — boîte contact@permanenceia.com
ZOHO_SMTP_HOST=smtp.zoho.com
ZOHO_SMTP_USER=contact@permanenceia.com
ZOHO_SMTP_PASS=
NOTIFY_EMAIL=contact@permanenceia.com
# Facultatif : format du journal du serveur (src/lib/log.ts). Sans valeur : JSON avec gravité (ERROR, WARNING, INFO) sur
# Cloud Run (App Hosting, variable K_SERVICE), texte ailleurs ; « json » le force, « text » le coupe
LOG_FORMAT=
# Jeton secret des webhooks et des outils d’agents Autocalls (en-tête x-webhook-token ou ?token=)
WEBHOOK_TOKEN=
# Secret (32 caractères au moins) des codes de vérification envoyés par email (/api/agent/account) et, par
# dérivation, des liens signés de préférences et de désinscription des emails (src/lib/emailPrefs.ts)
ACCOUNT_CODE_SECRET=
# Webhooks des automatisations Autocalls « rappel demandé → campagne » (France : commercial et support)
LEAD_WEBHOOK_COMMERCIAL=
LEAD_WEBHOOK_SUPPORT=
# Autres pays, en JSON par langue : {"en-gb":{"commercial":"https://…","support":"https://…"},"en-au":{…},"it":{…},"pl":{…},"nl":{…},"he":{…}}
LEAD_WEBHOOKS_INTL=
# Clé API white-label Autocalls (WhatsApp, SMS, dossier client)
AUTOCALLS_API_KEY=
# Clé partagée avec l’outil Autocalls « identifier_contact » (champ fixe key, 24 caractères au moins)
IDENTIFY_KEY=
# Facultatif : 0 coupe la confirmation écrite des tickets de support envoyée au client (src/lib/tickets.ts) ; absente = active
TICKET_CONFIRMATION=
# Relances commerciales (src/lib/relances, POST /api/cron/relances) — COUPÉES et en MODE TEST par défaut.
# Envoi réel seulement si RELANCES_ENABLED=1, relance_settings.enabled=true en base ET RELANCES_DRY_RUN=0.
RELANCES_ENABLED=
RELANCES_DRY_RUN=1
# Marchés ouverts aux e-mails commerciaux (défaut : fr,en-gb,en-au) et séries ouvertes (défaut : P,I,C,F,U,M,A,S ;
# A = mise en route, S = solde de minutes, messages de service)
RELANCES_LOCALES=
RELANCES_SEQUENCES=
# Langues des messages de service (I1, C1 à C5, F1, U1, séries A et S), facultatif : les 7 par défaut ; langue inconnue → anglais
RELANCES_SERVICE_LOCALES=
# Plafonds (au plus 20 par passage et 150 par jour ; sans valeur : 20/jour la 1re semaine, 50 la 2e, puis 150)
RELANCES_MAX_PER_RUN=
RELANCES_MAX_PER_DAY=
# Adresses ou domaines (@exemple.fr) jamais relancés (comptes de test), séparés par des virgules
RELANCES_EXCLUDE_EMAILS=
# Facultatif : solde de l’agence Autocalls (US$) sous lequel l’équipe est alertée, une fois par jour (défaut : 300 ; 0 coupe l’alerte)
RELANCES_AGENCY_BALANCE_MIN=
# Accès à la route planifiée : en-tête x-cron-token (32 caractères au moins), ou jeton OIDC de Cloud Scheduler
CRON_SECRET=
RELANCES_OIDC_AUDIENCE=
RELANCES_OIDC_EMAIL=
# Lecture seule de la boîte contact@ (réponses, rebonds et désinscriptions « unsubscribe » reçues par e-mail) ; sans elle,
# aucun e-mail marketing réel ne part
RELANCES_IMAP_HOST=imap.zoho.com
RELANCES_IMAP_PORT=993
RELANCES_IMAP_USER=
RELANCES_IMAP_PASS=
# Stripe du compte Permanence IA : secret de signature du webhook /api/webhooks/stripe, clé restreinte en lecture (clients)
STRIPE_WEBHOOK_SECRET=
STRIPE_READ_KEY=
